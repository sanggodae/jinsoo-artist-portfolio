{
  "entities": {
    "artwork": {
      "title": "Artwork",
      "description": "Fine art painting and artwork record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique artwork identifier" },
        "code": { "type": "string", "description": "Official artwork catalog code" },
        "title": { "type": "string", "description": "Artwork title" },
        "canvasSizeCode": { "type": "string", "description": "Standard canvas size code" },
        "widthCm": { "type": "number", "description": "Width in centimeters" },
        "heightCm": { "type": "number", "description": "Height in centimeters" },
        "material": { "type": "string", "description": "Painting material name" },
        "materialCode": { "type": "string", "description": "Material single letter code" },
        "year": { "type": "number", "description": "Year of production" },
        "description": { "type": "string", "description": "Artwork description or statement" },
        "displayOrder": { "type": "number", "description": "Display order integer" },
        "isFeatured": { "type": "boolean", "description": "Featured artwork flag" },
        "imageUrl": { "type": "string", "description": "Storage CDN or public image URL" },
        "createdAt": { "type": "string", "description": "Creation ISO timestamp" },
        "updatedAt": { "type": "string", "description": "Last update ISO timestamp" }
      },
      "required": ["id", "code", "title", "canvasSizeCode", "widthCm", "heightCm", "material", "materialCode", "year", "displayOrder", "isFeatured", "imageUrl", "createdAt", "updatedAt"]
    },
    "exhibition": {
      "title": "Exhibition",
      "description": "Artist solo or group exhibition record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Exhibition ID" },
        "title": { "type": "string", "description": "Exhibition title" },
        "type": { "type": "string", "description": "Solo, Group, or Art Fair" },
        "galleryName": { "type": "string", "description": "Gallery or venue name" },
        "location": { "type": "string", "description": "City or location" },
        "startDate": { "type": "string", "description": "Start date" },
        "endDate": { "type": "string", "description": "End date" },
        "curatorNote": { "type": "string", "description": "Curatorial text" },
        "displayOrder": { "type": "number", "description": "Sort order" },
        "posterUrl": { "type": "string", "description": "Poster or installation photo URL" }
      },
      "required": ["id", "title", "type", "galleryName", "startDate", "displayOrder"]
    },
    "award": {
      "title": "Award",
      "description": "Awards and contest honors",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Award ID" },
        "title": { "type": "string", "description": "Award title" },
        "organization": { "type": "string", "description": "Granting organization" },
        "year": { "type": "number", "description": "Award year" },
        "description": { "type": "string", "description": "Award details" },
        "displayOrder": { "type": "number", "description": "Display order" }
      },
      "required": ["id", "title", "organization", "year", "displayOrder"]
    },
    "cv": {
      "title": "Curriculum Vitae",
      "description": "Artist biography and curriculum vitae section",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "CV section key" },
        "category": { "type": "string", "description": "Category name (e.g. Education, Solo Exhibitions)" },
        "items": { "type": "array", "description": "Chronological CV list items" },
        "updatedAt": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["id", "category", "items", "updatedAt"]
    },
    "artistNote": {
      "title": "Artist Note",
      "description": "Artist statements and critical essays",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Note identifier" },
        "title": { "type": "string", "description": "Note title" },
        "writtenYear": { "type": "number", "description": "Written year" },
        "content": { "type": "string", "description": "Full statement markdown or text" },
        "critiqueAuthor": { "type": "string", "description": "Author or critic name if applicable" },
        "isPublished": { "type": "boolean", "description": "Published flag" },
        "displayOrder": { "type": "number", "description": "Display order" }
      },
      "required": ["id", "title", "writtenYear", "content", "isPublished", "displayOrder"]
    },
    "siteSettings": {
      "title": "Site Settings",
      "description": "Artist website metadata and global settings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Document ID" },
        "artistKoreanName": { "type": "string", "description": "Artist Korean name" },
        "artistEnglishName": { "type": "string", "description": "Artist English name" },
        "contactEmail": { "type": "string", "description": "Public contact email" },
        "instagramUrl": { "type": "string", "description": "Instagram link" },
        "coverArtworkId": { "type": "string", "description": "Selected hero artwork ID" },
        "aboutText": { "type": "string", "description": "Biography intro text" },
        "portfolioStatement": { "type": "string", "description": "Artist statement displayed on Cover page" },
        "updatedAt": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["id", "artistKoreanName", "artistEnglishName"]
    },
    "submission": {
      "title": "Submission",
      "description": "Private open call and exhibition submission package",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Submission package ID" },
        "targetOrganization": { "type": "string", "description": "Target gallery or organization" },
        "submissionDeadline": { "type": "string", "description": "Submission deadline date" },
        "selectedArtworkIds": { "type": "array", "description": "List of selected artwork IDs" },
        "memo": { "type": "string", "description": "Internal notes" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "targetOrganization", "selectedArtworkIds", "createdAt"]
    },
    "migrationTest": {
      "title": "Migration Test",
      "description": "Connection test document for Firestore database",
      "type": "object",
      "properties": {
        "test": { "type": "boolean", "description": "Test boolean flag" },
        "timestamp": { "type": "string", "description": "Test timestamp" }
      },
      "required": ["test", "timestamp"]
    }
  },
  "firestore": {
    "/migration-test/{docId}": {
      "schema": "migrationTest",
      "description": "Firestore connection test document"
    },
    "/artworks/{artworkId}": {
      "schema": "artwork",
      "description": "Artist artworks catalog and archive"
    },
    "/exhibitions/{exhibitionId}": {
      "schema": "exhibition",
      "description": "Artist exhibition records"
    },
    "/awards/{awardId}": {
      "schema": "award",
      "description": "Artist awards and honors"
    },
    "/cv/{cvId}": {
      "schema": "cv",
      "description": "Artist CV categories"
    },
    "/artistNotes/{noteId}": {
      "schema": "artistNote",
      "description": "Artist statements and critiques"
    },
    "/siteSettings/{settingsId}": {
      "schema": "siteSettings",
      "description": "Global website configuration"
    },
    "/submissions/{submissionId}": {
      "schema": "submission",
      "description": "Private submission packages (Admin only)"
    }
  }
}
