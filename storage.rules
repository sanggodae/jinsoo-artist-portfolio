rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper to verify if the requesting user is authenticated as the specific administrator
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'jinsoop10@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // Artworks storage: Public read, Admin write/delete
    match /artworks/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // General default fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
